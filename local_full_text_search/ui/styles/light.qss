* {
    font-family: "Microsoft YaHei UI", "Segoe UI", "Microsoft YaHei";
    font-size: 13px;
    color: #182230;
}

QMainWindow, QWidget#AppRoot, QFrame#Body {
    background: #F6F7F9;
}

QFrame#TopBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E4E7EC;
}

QLabel#TopTitle {
    font-size: 19px;
    font-weight: 600;
    color: #182230;
}

QLabel#TopSubtitle, QLabel#PageSubtitle, QLabel#MutedText, QLabel#ResultMeta, QLabel#ResultPath {
    color: #667085;
    font-size: 12px;
}

QLabel#IndexEta {
    color: #1769E0;
    font-size: 12px;
    font-weight: 600;
    min-width: 120px;
}

QPushButton#IndexStatusButton {
    min-height: 32px;
    padding: 5px 12px;
    border: 1px solid #D0D5DD;
    border-radius: 6px;
    background: #FFFFFF;
    color: #344054;
}

QPushButton#IndexStatusButton[state="ready"] {
    color: #16A34A;
    background: #F0FDF4;
    border-color: #BBF7D0;
}

QPushButton#IndexStatusButton[state="running"] {
    color: #2563EB;
    background: #EFF6FF;
    border-color: #BFDBFE;
}

QPushButton#IndexStatusButton[state="pending"] {
    color: #B45309;
    background: #FFFBEB;
    border-color: #FCD34D;
}

QPushButton#IndexStatusButton[state="error"] {
    color: #DC2626;
    background: #FEF2F2;
    border-color: #FECACA;
}

QFrame#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E4E7EC;
}

QFrame#Separator {
    background: #E4E7EC;
}

QPushButton#NavButton {
    min-height: 40px;
    text-align: left;
    padding: 0 14px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: #344054;
}

QPushButton#NavButton:hover {
    background: #F2F4F7;
}

QPushButton#NavButton[active="true"] {
    background: #EAF0F6;
    color: #174EA6;
    font-weight: 600;
}

QWidget#Page {
    background: #F6F7F9;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #182230;
}

QLabel#ContentHeading {
    font-size: 15px;
    font-weight: 600;
    color: #182230;
}

QFrame#SearchBox {
    min-height: 50px;
    max-height: 50px;
    border: 1px solid #D0D5DD;
    border-radius: 7px;
    background: #FFFFFF;
}

QFrame#SearchBox:focus-within {
    border: 1px solid #2563EB;
}

QLabel#SearchIcon {
    color: #667085;
    font-size: 20px;
    min-width: 22px;
}

QLineEdit#SearchInput {
    border: none;
    background: transparent;
    font-size: 16px;
    padding: 0;
    min-width: 160px;
    selection-background-color: #BFDBFE;
}

QFrame#SearchActionSeparator {
    background: #E4E7EC;
    border: none;
}

QPushButton#SearchActionButton {
    min-height: 30px;
    max-height: 30px;
    min-width: 48px;
    max-width: 48px;
    padding: 0;
    border: none;
    border-radius: 6px;
    background: #F9FAFB;
    color: #475467;
    font-size: 12px;
}

QPushButton#SearchActionButton:hover {
    background: #EAECF0;
    color: #182230;
}

QLineEdit {
    min-height: 34px;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    background: #FFFFFF;
    padding: 0 10px;
}

QLineEdit:focus {
    border: 1px solid #2563EB;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QTextEdit:disabled {
    color: #98A2B3;
    background: #F2F4F7;
    border-color: #E4E7EC;
}

QPushButton {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid #D0D5DD;
    border-radius: 6px;
    background: #FFFFFF;
    color: #344054;
}

QPushButton:hover {
    background: #F9FAFB;
    border-color: #B8C0CC;
}

QPushButton:pressed {
    background: #F2F4F7;
}

QPushButton:disabled {
    color: #B0B7C3;
    background: #F2F4F7;
    border-color: #E4E7EC;
}

QPushButton#PrimaryButton {
    min-height: 38px;
    background: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton#TextButton, QPushButton#IconButton {
    border: none;
    background: transparent;
    color: #344054;
}

QPushButton#TextButton:hover, QPushButton#IconButton:hover {
    background: #F2F4F7;
}

QPushButton#StopButton {
    background: #FEF2F2;
    border-color: #FECACA;
    color: #DC2626;
}

QPushButton#FilterButton, QComboBox#FilterControl {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid #D0D5DD;
    border-radius: 6px;
    background: #FFFFFF;
    color: #344054;
}

QPushButton#FilterButton:hover, QComboBox#FilterControl:hover {
    background: #F9FAFB;
    border-color: #B8C0CC;
}

QPushButton#FilterButton[active="true"] {
    color: #174EA6;
    background: #EAF0F6;
    border-color: #AFC5E2;
}

QComboBox {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    background: #FFFFFF;
}

QComboBox::drop-down {
    width: 22px;
    border: none;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #EFF6FF;
    selection-color: #2563EB;
}

QFrame#AdvancedFilters {
    background: #EEF2F6;
    border: none;
    border-radius: 6px;
}

QFrame#TaskStrip {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 6px;
}

QLabel#InlineStatus {
    color: #667085;
    font-size: 12px;
}

QLabel#TimingLabel {
    color: #174EA6;
    font-size: 12px;
    font-weight: 600;
}

QFrame#EmptyState {
    background: transparent;
}

QLabel#EmptyTitle {
    font-size: 20px;
    font-weight: 600;
    color: #182230;
}

QLabel#EmptySubtitle {
    color: #667085;
    font-size: 13px;
    line-height: 20px;
}

QListWidget#ResultList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#ResultList::item {
    background: transparent;
    border: none;
}

QFrame#ResultCard {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 6px;
}

QFrame#ResultCard:hover {
    background: #FBFDFF;
    border-color: #BFDBFE;
}

QFrame#ResultCard[selected="true"] {
    background: #EFF6FF;
    border-color: #93C5FD;
}

QFrame#ResultAccent {
    background: transparent;
    border-radius: 2px;
}

QFrame#ResultAccent[selected="true"] {
    background: #2563EB;
    border-radius: 2px;
}

QLabel#TypeIcon {
    min-width: 42px;
    max-width: 42px;
    min-height: 28px;
    border-radius: 6px;
    background: #F2F4F7;
    color: #344054;
    font-size: 11px;
    font-weight: 700;
}

QLabel#ResultTitle {
    font-size: 14px;
    font-weight: 600;
    color: #182230;
}

QLabel#ResultContext {
    color: #182230;
    font-size: 13px;
}

QLabel#HitBadge, QLabel#OcrBadge, QLabel#StatusBadge, QLabel#SuccessBadge {
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
}

QLabel#HitBadge {
    background: #EFF6FF;
    color: #2563EB;
}

QLabel#OcrBadge {
    background: #FFF7ED;
    color: #D97706;
}

QLabel#StatusBadge {
    background: #F2F4F7;
    color: #667085;
}

QLabel#SuccessBadge {
    background: #F0FDF4;
    color: #16A34A;
}

QFrame#PreviewPanel {
    background: #FFFFFF;
    border-left: 1px solid #E4E7EC;
}

QLabel#PreviewHeading {
    font-size: 13px;
    font-weight: 600;
    color: #667085;
}

QLabel#PreviewTitle {
    font-size: 16px;
    font-weight: 600;
    color: #182230;
}

QLabel#SectionTitle {
    font-size: 13px;
    font-weight: 600;
    color: #344054;
}

QTextEdit#PreviewContext, QTextEdit {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #BFDBFE;
}

QLabel#PreviewImage {
    background: #F6F7F9;
    border: 1px solid #E4E7EC;
    border-radius: 8px;
    padding: 8px;
}

QFrame#ScopeCard {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E4E7EC;
    border-radius: 0;
}

QFrame#ScopeCard:hover {
    background: #F9FAFB;
}

QFrame#SettingsCard {
    background: transparent;
    border: none;
    border-bottom: 1px solid #E4E7EC;
    border-radius: 0;
}

QLabel#ScopeTitle {
    font-size: 14px;
    font-weight: 600;
    color: #182230;
}

QFrame#Pager {
    background: transparent;
}

QTableWidget#FailedTable {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: #EFF6FF;
    selection-color: #182230;
}

QTableWidget#FailedTable::item {
    min-height: 44px;
    border-bottom: 1px solid #F2F4F7;
    padding: 6px;
}

QHeaderView::section {
    background: #F9FAFB;
    color: #667085;
    border: none;
    border-bottom: 1px solid #E4E7EC;
    padding: 9px 8px;
    font-weight: 600;
}

QCheckBox {
    spacing: 8px;
    color: #344054;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #D0D5DD;
    border-radius: 4px;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background: #2563EB;
    border-color: #2563EB;
}

QSpinBox, QDoubleSpinBox {
    min-height: 34px;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    background: #FFFFFF;
    padding: 0 8px;
}

QPushButton#DisclosureButton {
    min-height: 38px;
    text-align: left;
    padding: 0 14px;
    border: none;
    border-radius: 6px;
    background: #FFFFFF;
    color: #174EA6;
    font-weight: 600;
}

QPushButton#DisclosureButton:hover, QPushButton#DisclosureButton:checked {
    background: #EAF0F6;
}

QProgressBar {
    min-height: 8px;
    max-height: 8px;
    border: none;
    border-radius: 4px;
    background: #E4E7EC;
}

QProgressBar::chunk {
    border-radius: 4px;
    background: #2563EB;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    min-height: 28px;
    padding: 4px 24px 4px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #EFF6FF;
    color: #2563EB;
}

QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 2px;
}

QScrollBar::handle:vertical {
    min-height: 36px;
    border-radius: 5px;
    background: #D0D5DD;
}

QScrollBar::handle:vertical:hover {
    background: #98A2B3;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}
