  "patterns": {
    "identifier_candidate": "(?<![A-Za-z0-9_])[A-Z][A-Z0-9]{1,15}(?![A-Za-z0-9_])",
    "instrument_model": "(?<![A-Za-z0-9])[A-Za-z]{1,6}-[0-9]{3,6}[A-Za-z]?(?![A-Za-z0-9])",
    "numeric_unit": "[0-9]+(?:\\.[0-9]+)?(?:\\s*[±]\\s*[0-9]+(?:\\.[0-9]+)?)?\\s*(?:μL/s|uL/s|mL/min|μL|uL|mL|CPS|RLU|rpm|mmol/L|%|℃|°C)",
    "software_version": "(?:软件版本|版本号|软件)\\s*[:：]?\\s*[Vv]?\\d+(?:\\.\\d+){1,3}"
  },
  "policy": {
    "activation_confidence": 0.9,
    "max_exact_representatives": 2,
    "scope_patterns": {
      "fault_precondition": "(?:如果|若|当|在)[^，。；？\\n]{2,35}(?:时|后|情况下)",
      "time_condition": "(?:上次|本次|当前|前一次|仍然|重新|首次|再次)",
      "negative_condition": "(?:不是|并非|没有|不能|未)[^，。；？\\n]{1,24}",
      "numeric_range": "(?:超过|不超过|低于|高于|至少|至多|允许范围|允许误差|阈值)[^，。；？\\n]{0,18}"
    },
    "scope_entity_types": [
      "instrument_model",
      "product_line",
      "reagent",
      "calibrator",
      "software_version",
      "stage",
      "component"
    ]
  },
  "entity_hierarchy": {
    "levels": [
      "system",
      "module",
      "component",
      "subcomponent",
      "consumable"
    ],
    "binding": "explicit_question_spans_only"
  },
  "model_aliases": {},
  "units": [
    "V",
    "mA",
    "μL/s",
    "mL/min",
    "CPS",
    "RLU",
    "rpm",
    "mmol/L",
    "%",
    "℃",
    "次测试"
  ],
  "scope_levels": [
    "single",
    "multiple",
    "all"
  ],
  "ambiguity_rules": [
    "separate_noun_mentions_require_separate_binding"
  ]
}
